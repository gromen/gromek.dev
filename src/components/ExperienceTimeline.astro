---
import type { Locale } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

interface Experience {
  company: string;
  role: string;
  period: string;
  description: string;
}

const experiences: Experience[] = t.experience.timeline;
---

<section class="py-12 sm:py-16" aria-labelledby="experience-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id="experience-heading" class="text-3xl sm:text-4xl font-bold text-text mb-8 sm:mb-12">
      {t.experience.heading}
    </h2>

    <div class="relative">
      <!-- Timeline line - hidden on mobile, visible from sm breakpoint -->
      <div
        class="hidden sm:block absolute left-0 sm:left-8 top-0 bottom-0 w-0.5 bg-text/10"
        aria-hidden="true"
      ></div>

      <ol reversed class="space-y-8 sm:space-y-12">
        {experiences.map((exp, index) => (
          <li class="relative">
            <!-- Timeline dot - hidden on mobile, visible from sm breakpoint -->
            <div
              class="hidden sm:flex absolute left-8 -translate-x-1/2 w-4 h-4 bg-primary rounded-full border-4 border-background"
              aria-hidden="true"
            ></div>

            <div class="sm:pl-20">
              <div class="bg-background rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow border border-text/10">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                  <h3 class="text-xl sm:text-2xl font-bold text-text">
                    {exp.company}
                  </h3>
                  <span class="text-sm sm:text-base text-text/60 font-medium whitespace-nowrap">
                    {exp.period}
                  </span>
                </div>

                <p class="text-base sm:text-lg font-medium text-primary mb-2">
                  {exp.role}
                </p>

                <p class="text-sm sm:text-base text-text/70 leading-relaxed">
                  {exp.description}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
