---
import ThemeToggle from './ThemeToggle.astro';
import type { Locale } from '../i18n/utils';
import { getTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '' } = Astro.props;
const t = getTranslations(locale);

const otherLocale: Locale = locale === 'pl' ? 'en' : 'pl';

// Map PL paths to EN paths (PL is root, EN has /en prefix)
const pathMap: Record<string, string> = {
  '/': '/',
  '/portfolio': '/portfolio',
  '/kontakt': '/contact',
  '/en/': '/',
  '/en/portfolio': '/portfolio',
  '/en/contact': '/kontakt',
  '/uslugi': '/services',
  '/en/services': '/uslugi',
};

const switchPath = pathMap[currentPath] || '/';
const langSwitchUrl = getLocalizedPath(otherLocale, switchPath);

const navItems = [
  { href: getLocalizedPath(locale, '/'), label: t.nav.home },
  { href: getLocalizedPath(locale, '/portfolio'), label: t.nav.portfolio },
  { href: getLocalizedPath(locale, locale === 'pl' ? '/uslugi' : '/services'), label: t.nav.services },
  { href: getLocalizedPath(locale, locale === 'pl' ? '/kontakt' : '/contact'), label: t.nav.contact },
];
---

<!-- Spacer to offset fixed nav -->
<div class="h-20 sm:h-24" aria-hidden="true"></div>

<nav
  id="main-nav"
  class="fixed top-3 sm:top-4 left-3 right-3 sm:left-4 sm:right-4 z-50 mx-auto max-w-7xl rounded-2xl border border-text/10 bg-background/70 backdrop-blur-xl shadow-lg shadow-background/20"
>
  <div class="px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 sm:h-16">
      <!-- Logo + desktop links -->
      <div class="flex items-center gap-6 sm:gap-8">
        <a href={getLocalizedPath(locale, '/')} class="flex items-center" aria-label="Marcin Gromek - strona główna">
          <img src="/mg_logo_trans.png" alt="MG" width="40" height="40" class="h-9 sm:h-10 w-auto" />
        </a>
        <div class="hidden md:flex gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-150',
                item.href === currentPath
                  ? 'bg-text/10 text-text'
                  : 'text-text/70 hover:text-text hover:bg-text/5',
              ]}
              aria-current={item.href === currentPath ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Right side: lang switch, theme toggle, mobile hamburger -->
      <div class="flex items-center gap-1 sm:gap-2">
        <a
          href={langSwitchUrl}
          class="px-3 py-2 rounded-lg text-sm font-medium text-text/70 hover:text-text hover:bg-text/5 transition-colors duration-150 uppercase"
          aria-label={`Switch to ${otherLocale}`}
        >
          {otherLocale}
        </a>
        <ThemeToggle />

        <!-- Mobile menu button -->
        <button
          type="button"
          class="md:hidden p-2.5 rounded-lg hover:bg-text/5 transition-colors duration-150"
          aria-label="Toggle mobile menu"
          id="mobile-menu-button"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger flex flex-col justify-center items-center w-6 h-6 gap-[5px]" aria-hidden="true">
            <span class="bar block w-5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
            <span class="bar block w-5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
            <span class="bar block w-5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu (expands within floating container) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-text/10">
    <div class="px-3 pt-2 pb-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block px-3 py-2.5 rounded-lg text-base font-medium transition-colors duration-150',
            item.href === currentPath
              ? 'bg-text/10 text-text'
              : 'text-text/70 hover:text-text hover:bg-text/5',
          ]}
          aria-current={item.href === currentPath ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  /* Entrance animation */
  #main-nav {
    animation: nav-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes nav-enter {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hide/show on scroll */
  #main-nav {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;

    &.nav-hidden {
      transform: translateY(-120%);
      opacity: 0;
    }
  }

  /* Hamburger → X */
  #mobile-menu-button.is-open .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #mobile-menu-button.is-open .bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-button.is-open .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Menu slide-down */
  #mobile-menu:not(.hidden) {
    animation: menu-slide 0.2s ease-out;
  }

  /* Stagger links */
  #mobile-menu:not(.hidden) a:nth-child(1) { animation: fade-up 0.25s ease-out 0.05s both; }
  #mobile-menu:not(.hidden) a:nth-child(2) { animation: fade-up 0.25s ease-out 0.10s both; }
  #mobile-menu:not(.hidden) a:nth-child(3) { animation: fade-up 0.25s ease-out 0.15s both; }
  #mobile-menu:not(.hidden) a:nth-child(4) { animation: fade-up 0.25s ease-out 0.20s both; }

  @keyframes menu-slide {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #main-nav,
    #mobile-menu:not(.hidden),
    #mobile-menu:not(.hidden) a {
      animation: none;
    }
    #main-nav {
      transition: none;
    }
    .bar {
      transition: none;
    }
  }
</style>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const nav = document.getElementById('main-nav');

  // Mobile menu toggle
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenuButton?.setAttribute('aria-expanded', String(isOpen));
    mobileMenuButton?.classList.toggle('is-open', isOpen);
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!mobileMenuButton?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      mobileMenuButton?.classList.remove('is-open');
    }
  });

  // Clear entrance animation so scroll transform can take over
  nav?.addEventListener('animationend', () => {
    nav.style.animation = 'none';
  }, { once: true });

  // Hide/show nav on scroll
  let lastScrollY = 0;
  let ticking = false;

  const onScroll = () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 80 && currentScrollY > lastScrollY) {
      nav?.classList.add('nav-hidden');
    } else {
      nav?.classList.remove('nav-hidden');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });
</script>
