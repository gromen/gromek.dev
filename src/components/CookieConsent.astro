---
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const translations = {
  pl: {
    message: 'Ta strona używa plików cookies w celach analitycznych.',
    accept: 'Akceptuję',
    reject: 'Tylko niezbędne',
    privacyPolicy: 'Polityka prywatności',
    privacyPolicyHref: '/polityka-prywatnosci',
  },
  en: {
    message: 'This site uses cookies for analytics purposes.',
    accept: 'Accept',
    reject: 'Only necessary',
    privacyPolicy: 'Privacy policy',
    privacyPolicyHref: '/en/privacy-policy',
  },
} as const;

const t = translations[locale];
---

<div
  id="cookie-consent-bar"
  role="region"
  aria-label={locale === 'pl' ? 'Zgoda na pliki cookies' : 'Cookie consent'}
  aria-live="polite"
  style="display:none;will-change:transform"
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-gray-200/60 dark:border-gray-700/60 bg-white/85 dark:bg-gray-900/85 backdrop-blur-md"
>
  <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-gray-700 dark:text-gray-300">
        {t.message}{' '}
        <a
          href={t.privacyPolicyHref}
          class="underline underline-offset-2 decoration-gray-400 hover:decoration-gray-700 dark:decoration-gray-500 dark:hover:decoration-gray-300 transition-[text-decoration-color] duration-150"
        >
          {t.privacyPolicy}
        </a>
      </p>
      <div class="flex shrink-0 gap-2">
        <button
          id="cookie-consent-reject"
          type="button"
          class="rounded-md border border-gray-300 dark:border-gray-600 bg-transparent px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 transition-colors duration-150"
        >
          {t.reject}
        </button>
        <button
          id="cookie-consent-accept"
          type="button"
          class="rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 dark:hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 transition-colors duration-150"
        >
          {t.accept}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #cookie-consent-bar {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);

    &.is-visible {
      transform: translateY(0) !important;
    }

    &.is-hidden {
      transform: translateY(100%) !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'cookie-consent';

    function getConsent() {
      try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
    }

    function setConsent(value) {
      try { localStorage.setItem(STORAGE_KEY, value); } catch (e) {}
    }

    function init() {
      var existing = getConsent();
      if (existing === 'accepted' || existing === 'rejected') return;

      var bar = document.getElementById('cookie-consent-bar');
      if (!bar) return;

      var acceptBtn = document.getElementById('cookie-consent-accept');
      var rejectBtn = document.getElementById('cookie-consent-reject');
      var dismissed = false;

      bar.style.display = 'block';

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          bar.classList.add('is-visible');
        });
      });

      function dismiss(value) {
        if (dismissed) return;
        dismissed = true;
        if (acceptBtn) acceptBtn.disabled = true;
        if (rejectBtn) rejectBtn.disabled = true;
        setConsent(value);
        bar.classList.remove('is-visible');
        bar.classList.add('is-hidden');
        bar.addEventListener(
          'transitionend',
          function () { bar.style.display = 'none'; },
          { once: true }
        );
      }

      if (acceptBtn) {
        acceptBtn.addEventListener('click', function () {
          dismiss('accepted');
          document.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
        });
      }

      if (rejectBtn) {
        rejectBtn.addEventListener('click', function () {
          dismiss('rejected');
        });
      }
    }

    if (typeof requestIdleCallback === 'function') {
      requestIdleCallback(init, { timeout: 3000 });
    } else {
      setTimeout(init, 200);
    }
  })();
</script>
