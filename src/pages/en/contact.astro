---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/utils';

const t = getTranslations('en');
const title = `${t.nav.contact} — Marcin Gromek`;
---

<BaseLayout title={title} locale="en">
  <div class="min-h-screen flex flex-col">
    <Navigation locale="en" currentPath="/en/contact" />
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <div class="max-w-4xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">{t.contact.heading}</h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 max-w-2xl">{t.contact.description}</p>
      </div>

      <div class="mt-12 sm:mt-16 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Contact Information -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-semibold mb-6">{t.contact.info.heading}</h2>

            <div class="space-y-6">
              <!-- Email -->
              <div>
                <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">{t.contact.info.email}</h3>
                <a
                  href="mailto:gromek.marcin@outlook.com"
                  class="text-lg text-blue-600 dark:text-blue-400 hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 rounded"
                  aria-label="Send email to gromek.marcin@outlook.com"
                >
                  gromek.marcin@outlook.com
                </a>
              </div>

              <!-- Phone -->
              <div>
                <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">{t.contact.info.phone}</h3>
                <a
                  href="tel:+48666211109"
                  class="text-lg text-blue-600 dark:text-blue-400 hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 rounded"
                  aria-label="Call +48 666 211 109"
                >
                  +48 666 211 109
                </a>
              </div>

              <!-- Social Links -->
              <div>
                <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">{t.contact.info.social}</h3>
                <div class="flex flex-col space-y-3">
                  <a
                    href="https://www.linkedin.com/in/gromekmarcin"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-blue-600 dark:text-blue-400 hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 rounded inline-flex items-center gap-2"
                    aria-label="Visit Marcin Gromek's LinkedIn profile (opens in new tab)"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                  </a>
                  <a
                    href="https://github.com/gromen"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-blue-600 dark:text-blue-400 hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 rounded inline-flex items-center gap-2"
                    aria-label="Visit Marcin Gromek's GitHub profile (opens in new tab)"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
                    </svg>
                    GitHub
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-semibold mb-6">{t.contact.form.heading}</h2>

          <form
            id="contact-form"
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
            class="space-y-6"
            novalidate
          >
            <!-- Honeypot field for spam prevention (hidden from users) -->
            <input
              type="text"
              name="_gotcha"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <!-- Name field -->
            <div>
              <label for="name" class="block text-sm font-medium mb-2">
                {t.contact.form.name}
                <span class="text-red-500 dark:text-red-400" aria-label="required field">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder={t.contact.form.namePlaceholder}
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                aria-required="true"
                aria-describedby="name-error"
              />
              <p id="name-error" class="mt-1 text-sm text-red-600 dark:text-red-400 hidden" role="alert"></p>
            </div>

            <!-- Email field -->
            <div>
              <label for="email" class="block text-sm font-medium mb-2">
                {t.contact.form.email}
                <span class="text-red-500 dark:text-red-400" aria-label="required field">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder={t.contact.form.emailPlaceholder}
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                aria-required="true"
                aria-describedby="email-error"
              />
              <p id="email-error" class="mt-1 text-sm text-red-600 dark:text-red-400 hidden" role="alert"></p>
            </div>

            <!-- Message field -->
            <div>
              <label for="message" class="block text-sm font-medium mb-2">
                {t.contact.form.message}
                <span class="text-red-500 dark:text-red-400" aria-label="required field">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder={t.contact.form.messagePlaceholder}
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors resize-y"
                aria-required="true"
                aria-describedby="message-error"
              ></textarea>
              <p id="message-error" class="mt-1 text-sm text-red-600 dark:text-red-400 hidden" role="alert"></p>
            </div>

            <!-- Submit button -->
            <button
              type="submit"
              class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 disabled:opacity-50 disabled:cursor-not-allowed"
              aria-label="Submit contact form"
            >
              <span class="submit-text">{t.contact.form.submit}</span>
            </button>

            <!-- Status messages -->
            <div id="form-status" class="hidden" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </main>
    <Footer locale="en" />
  </div>
</BaseLayout>

<script>
  // Client-side form validation and submission handling
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement;
  const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const submitText = submitButton.querySelector('.submit-text') as HTMLSpanElement;
  const formStatus = document.getElementById('form-status') as HTMLDivElement;

  // Validation messages (from translations)
  const validationMessages = {
    nameRequired: 'Full name is required',
    emailRequired: 'Email address is required',
    emailInvalid: 'Please enter a valid email address',
    messageRequired: 'Message is required',
    submitting: 'Sending...',
    success: 'Thank you! Your message has been sent. I\'ll get back to you as soon as possible.',
    error: 'An error occurred while sending the message. Please try again or contact me directly.',
    submit: 'Send message'
  };

  // Validation functions
  function showError(input: HTMLInputElement | HTMLTextAreaElement, message: string): void {
    const errorElement = document.getElementById(`${input.id}-error`) as HTMLParagraphElement;
    errorElement.textContent = message;
    errorElement.classList.remove('hidden');
    input.setAttribute('aria-invalid', 'true');
    input.classList.add('border-red-500', 'dark:border-red-400');
  }

  function clearError(input: HTMLInputElement | HTMLTextAreaElement): void {
    const errorElement = document.getElementById(`${input.id}-error`) as HTMLParagraphElement;
    errorElement.textContent = '';
    errorElement.classList.add('hidden');
    input.setAttribute('aria-invalid', 'false');
    input.classList.remove('border-red-500', 'dark:border-red-400');
  }

  function validateName(): boolean {
    const value = nameInput.value.trim();
    if (!value) {
      showError(nameInput, validationMessages.nameRequired);
      return false;
    }
    clearError(nameInput);
    return true;
  }

  function validateEmail(): boolean {
    const value = emailInput.value.trim();
    if (!value) {
      showError(emailInput, validationMessages.emailRequired);
      return false;
    }
    // Email validation regex
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(value)) {
      showError(emailInput, validationMessages.emailInvalid);
      return false;
    }
    clearError(emailInput);
    return true;
  }

  function validateMessage(): boolean {
    const value = messageInput.value.trim();
    if (!value) {
      showError(messageInput, validationMessages.messageRequired);
      return false;
    }
    clearError(messageInput);
    return true;
  }

  function showFormStatus(message: string, isError: boolean = false): void {
    formStatus.textContent = message;
    formStatus.classList.remove('hidden');
    formStatus.classList.toggle('text-red-600', isError);
    formStatus.classList.toggle('dark:text-red-400', isError);
    formStatus.classList.toggle('text-green-600', !isError);
    formStatus.classList.toggle('dark:text-green-400', !isError);
    formStatus.classList.add('p-4', 'rounded-lg', 'border');
    formStatus.classList.toggle('border-red-200', isError);
    formStatus.classList.toggle('dark:border-red-800', isError);
    formStatus.classList.toggle('bg-red-50', isError);
    formStatus.classList.toggle('dark:bg-red-900/20', isError);
    formStatus.classList.toggle('border-green-200', !isError);
    formStatus.classList.toggle('dark:border-green-800', !isError);
    formStatus.classList.toggle('bg-green-50', !isError);
    formStatus.classList.toggle('dark:bg-green-900/20', !isError);
  }

  // Real-time validation on blur
  nameInput.addEventListener('blur', validateName);
  emailInput.addEventListener('blur', validateEmail);
  messageInput.addEventListener('blur', validateMessage);

  // Clear errors on input
  nameInput.addEventListener('input', () => clearError(nameInput));
  emailInput.addEventListener('input', () => clearError(emailInput));
  messageInput.addEventListener('input', () => clearError(messageInput));

  // Form submission
  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    // Validate all fields
    const isNameValid = validateName();
    const isEmailValid = validateEmail();
    const isMessageValid = validateMessage();

    if (!isNameValid || !isEmailValid || !isMessageValid) {
      return;
    }

    // Disable form during submission
    submitButton.disabled = true;
    submitText.textContent = validationMessages.submitting;
    formStatus.classList.add('hidden');

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        showFormStatus(validationMessages.success, false);
        form.reset();
      } else {
        showFormStatus(validationMessages.error, true);
      }
    } catch (error) {
      showFormStatus(validationMessages.error, true);
    } finally {
      submitButton.disabled = false;
      submitText.textContent = validationMessages.submit;
    }
  });
</script>
