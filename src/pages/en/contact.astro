---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/utils';

const t = getTranslations('en');
const title = `${t.nav.contact} — Marcin Gromek`;
---

<BaseLayout title={title} locale="en">
  <div class="min-h-screen flex flex-col">
    <Navigation locale="en" currentPath="/en/contact" />
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-4xl font-bold">{t.nav.contact}</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Contact page EN — placeholder</p>
    </main>
    <Footer locale="en" />
  </div>
</BaseLayout>
