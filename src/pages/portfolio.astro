---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

const t = getTranslations('pl');
const title = `${t.nav.portfolio} — Marcin Gromek`;

const allProjects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} description={t.portfolio.description} locale="pl">
    <Navigation locale="pl" currentPath="/portfolio" />
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          {t.portfolio.title}
        </h1>
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-3xl">
          {t.portfolio.description}
        </p>
      </header>

      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              url={project.data.url}
              technologies={project.data.technologies}
              image={project.data.image}
            />
          ))}
        </div>
      </section>
    </main>
    <Footer locale="pl" />
</BaseLayout>
