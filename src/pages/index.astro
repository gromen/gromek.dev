---
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Navigation from '../components/Navigation.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { getTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const t = getTranslations('pl');
---

<BaseLayout
  title={`${t.hero.name} | ${t.hero.title} — React, Shopify, WordPress`}
  description="Frontend Developer z 10+ latami doświadczenia. Specjalizuję się w React, Shopify i WordPress. Tworzę szybkie i responsywne aplikacje webowe."
  locale="pl"
>
    <Navigation locale="pl" currentPath="/" />

    <main id="main-content" class="flex-1">
      <!-- Hero Section -->
      <Hero
        locale="pl"
        subtitle={t.hero.subtitle}
        ctaText={t.hero.cta}
        ctaHref="/portfolio"
      />

      <!-- About Section -->
      <section class="py-16 bg-text/5">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold mb-6">{t.about.heading}</h2>
          <p class="text-xl text-text/70 font-semibold mb-4">
            {t.about.experience}
          </p>
          <p class="text-lg text-text/60 leading-relaxed">
            {t.about.description}
          </p>
        </div>
      </section>

      <!-- Tech Stack Section -->
      <section class="py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold mb-8">{t.techStack.heading}</h2>
          <div class="flex flex-wrap gap-3">
            {t.techStack.skills.map((skill: string) => (
              <SkillBadge skill={skill} />
            ))}
          </div>
        </div>
      </section>

      <!-- Featured Projects Section -->
      <section class="py-16 bg-text/5">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold mb-8">{t.projects.heading}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            {t.projects.highlights.map((project: any) => (
              <article class="bg-background rounded-lg border border-text/10 p-6 hover:shadow-lg transition-shadow opacity-0 motion-reduce:opacity-100" data-animate>
                <h3 class="text-xl font-semibold mb-3">{project.title}</h3>
                <p class="text-text/60 mb-4">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag: string) => (
                    <span class="text-xs px-2 py-1 rounded bg-primary/10 text-primary">
                      {tag}
                    </span>
                  ))}
                </div>
              </article>
            ))}
          </div>
          <div class="text-center">
            <a
              href="/portfolio"
              class="inline-flex items-center text-primary font-medium"
            >
              {t.projects.viewAll}
              <svg
                class="ml-2 w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Experience Timeline Section -->
      <ExperienceTimeline locale="pl" />

      <!-- CTA Section -->
      <section class="py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-3xl font-bold mb-4">{t.cta.heading}</h2>
          <p class="text-xl text-text/60 mb-8">
            {t.cta.description}
          </p>
          <a
            href="/kontakt"
            class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg
                   bg-primary text-background hover:bg-primary/90 hover:scale-105 active:scale-95 transition-transform duration-200
                   focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
          >
            {t.cta.button}
          </a>
        </div>
      </section>
    </main>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                entry.target.classList.add('animate-fade-up');
                entry.target.classList.remove('opacity-0');
              }, i * 100);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );

      document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el));
    </script>

    <Footer locale="pl" />
</BaseLayout>
