---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/utils';

const t = getTranslations('pl');
const title = `${t.nav.portfolio} — Marcin Gromek`;
---

<BaseLayout title={title} locale="pl">
  <div class="min-h-screen flex flex-col">
    <Navigation locale="pl" currentPath="/pl/portfolio" />
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-4xl font-bold">{t.nav.portfolio}</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Portfolio page PL — placeholder</p>
    </main>
    <Footer locale="pl" />
  </div>
</BaseLayout>
